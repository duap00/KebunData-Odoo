<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="solution_page" name="Water Quality Solution Page">
        <t t-call="website.layout">
            <div class="kebun-wq-hero py-5 bg-light text-center">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-lg-8 mx-auto">
                            <p class="text-uppercase text-success fw-bold mb-2">KebunData IoT</p>
                            <h1 class="display-5 fw-bold">Water Quality Monitoring for Smart Farms</h1>
                            <p class="lead text-secondary">A modern water quality dashboard for pH, EC, TDS, Salinity, Specific Gravity and Temperature with live telemetry simulation and future-ready sensor integration.</p>
                            <a href="#dashboard" class="btn btn-primary btn-lg me-2 mt-3">View Live Dashboard</a>
                            <a href="#contact" class="btn btn-outline-secondary btn-lg mt-3">Contact Sales</a>
                        </div>
                    </div>
                </div>
            </div>
            <section class="container py-5">
                <div class="row g-4">
                    <div class="col-lg-4">
                        <div class="card shadow-sm rounded-4 border-0 p-4 h-100">
                            <h3>Water Quality Overview</h3>
                            <p>See all six water quality metrics in a single connected monitoring solution designed for aquaculture, hydroponics and environmental sensing.</p>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="card shadow-sm rounded-4 border-0 p-4 h-100">
                            <h3>Live Sensor Telemetry</h3>
                            <p>Live charts update every second using realistic simulated sensor drift, ready for MQTT and IoT gateway integration.</p>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="card shadow-sm rounded-4 border-0 p-4 h-100">
                            <h3>Future-Ready Architecture</h3>
                            <p>Built with Odoo 18, OWL, Chart.js and modular service architecture so real hardware can be dropped in later.</p>
                        </div>
                    </div>
                </div>
            </section>
            <section class="container-fluid p-0 bg-white" id="dashboard">
                <div class="wq-dashboard-container" style="min-height: 800px;">
                    <!-- OWL Dashboard will be mounted here by website_dashboard.js -->
                </div>
            </section>
            <section class="container py-5">
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="card rounded-4 shadow-sm border-0 p-4 h-100">
                            <h5>Modern Design</h5>
                            <p>White cards, green accents, rounded corners and elegant spacing inspired by cloud dashboards and SCADA UI.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card rounded-4 shadow-sm border-0 p-4 h-100">
                            <h5>Ready for IoT</h5>
                            <p>Abstracted sensor service means MQTT, REST or ESP32 data sources can replace simulation without frontend rewrites.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card rounded-4 shadow-sm border-0 p-4 h-100">
                            <h5>Built on Odoo</h5>
                            <p>Full Odoo 18 Community compatibility with backend modularity, website pages, and dashboard action integration.</p>
                        </div>
                    </div>
                </div>
            </section>
            <section class="container py-5 border-top" id="contact">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <h2>Start your water quality project</h2>
                        <p class="text-secondary">Contact KebunData to integrate live water quality telemetry into your farm, greenhouse, or industrial system.</p>
                    </div>
                    <div class="col-lg-4 text-lg-end">
                        <a href="mailto:info@kebundata.com" class="btn btn-primary btn-lg">Contact Us</a>
                    </div>
                </div>
            </section>
        </t>
    </template>
</odoo>
